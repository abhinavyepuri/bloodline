# App Settings
PROJECT_NAME="PS-1 Smart Blood & Emergency Donor Network"
API_V1_STR="/api/v1"
DEBUG=True
ENVIRONMENT="development"
SECRET_KEY="replace-this-in-production-with-a-very-secure-random-secret-key-minimum-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (PostgreSQL with PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartblood_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartblood_db

# Redis Settings (Locks, Caching, PubSub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_URL=redis://localhost:6379/0

# Optimization & Geofencing Parameters
DEFAULT_GEOFENCE_RADIUS_KM=5.0
EXPANDED_GEOFENCE_RADIUS_KM=15.0
DONOR_RESPONSE_TTL_SECONDS=180
WHOLE_BLOOD_DONATION_INTERVAL_DAYS=40
PLATELET_DONATION_INTERVAL_DAYS=14
